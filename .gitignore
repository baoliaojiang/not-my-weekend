# 构建产物（体积大，且能由源码重建）
build/out/
build/www/
build/apk-work/
build/_font/

# 素材生成过程中的中间图
generated-images/
preview_*.png
sprite_sheet.png
bg_sheet.jpg
old_sun.png

# 依赖与临时文件
node_modules/
*.log
.tmp-*
tmp/

# WorkBuddy 会话数据：完全不该进开源仓库（含备份、记忆、截图）
.workbuddy/

# 内部构建缓存与历史产物
dist-old/
build/pkg/
build/www-compat/
build/android/assets/www/
build/android/assets/www.pkg
build/keystore.jks
.deploy/
build/_trash/

# PV 试玩版与美术素材：内部资产，不开源
pv/

# 自查截图与一次性中间产物
build/_*/
build/_*.png
_sprite_test.html

# 抓曲/压图过程中的中间产物
build/_kmcache/
build/_orig/
build/_music_bak/

# 各版本的热更包解压目录：可由 zip 重新解出来，不进仓库（省几十 MB）
releases/hotfix-*/www-*/

# 各版本的热更包解压目录：可由 zip 重新解出来，不进仓库（省几十 MB）
